{
  "ConnectionStrings": {
    "ZooFinder": "YOUR_SQL_SERVER_CONNECTION_STRING"
  },
  "Auth": {
    "RefreshSessionLifetime": "30.00:00:00"
  },
  "Jwt": {
    "Issuer": "ZooFinder",
    "Audience": "ZooFinder.Client",
    "SigningKeyBase64": "YOUR_BASE64_SIGNING_KEY",
    "Lifetime": "00:15:00"
  },
  "Wiki": {
    "UserAgent": "ZooFinder/0.1 (YOUR_CONTACT_URL_OR_EMAIL)",
    "RequestTimeout": "00:00:10",
    "SearchCacheLifetime": "00:02:00",
    "DetailsCacheLifetime": "00:15:00",
    "MaximumResponseBytes": 2097152
  },
  "Recognition": {
    "BaseUrl": "http://127.0.0.1:8000/",
    "RequestTimeout": "00:01:00",
    "MaximumResponseBytes": 1048576,
    "SupportedImageTypes": ["image/jpeg", "image/png", "image/webp"]
  },
  "MemoryCache": {
    "SizeLimit": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
